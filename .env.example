SECRET_KEY=your-secret-key-here
DATABASE_URL=sqlite:///volstruisgids.db

# === Yoco Payment Integration (for Grok + Yoco MCP live debugging) ===
# See .grok/config.toml for the Yoco MCP server that lets the coding agent call
# create_checkout / get_checkout / etc. directly while editing the Flask code.
FLASK_ENV=development
YOCO_TEST_MODE=true
YOCO_TEST_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_REAL_TEST_SECRET_KEY_FROM_YOCO_DASHBOARD
YOCO_LIVE_SECRET_KEY=sk_live_REPLACE_WITH_YOUR_REAL_LIVE_SECRET_KEY
YOCO_WEBHOOK_SECRET=whsec_REPLACE_WITH_YOUR_REAL_WEBHOOK_SECRET

# To register the webhook via API (when the UI is hard to find), run:
#   python register_yoco_webhook.py
# (first expose your server with ngrok for a public https URL)

# === Admin Panel (VOL-FEAT-2026-06-20) ===
# Comma-separated list of usernames (primary) or emails that get full admin access.
# No DB changes. Edit .env and restart to grant/revoke.
# Example: ADMIN_USERNAMES=alice,support,bob
ADMIN_USERNAMES=
